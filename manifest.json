{
	"manifest_version":1,
	"type":"WebApp",
	"meta":{
		"name":"FPS Overlay",
		"version":"1.0.0",
		"minimum-overwolf-version":"0.199.0.15",
		"author":"ForgeFace",
		"icon":"IconMouseOver.png",
		"icon_gray":"IconMouseNormal.png",
		"description":"An FPS overlay application"
	},
	"data": {
		"start_window":"MainWindow",
		"windows":{
			"MainWindow":{
					"file":"index.html",
					"transparent": true,
					"resizable": false,
					"use_os_windowing": false,
					"size": {
						"width":200,
						"height":60
						},
					"min_size": {
						"width":100,
						"height":60
					}
				}
		}
	}
}